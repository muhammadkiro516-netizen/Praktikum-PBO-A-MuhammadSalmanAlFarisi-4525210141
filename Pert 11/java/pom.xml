<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             http://maven.apache.org/xsd/maven-4.0.0.xsd">

  <modelVersion>4.0.0</modelVersion>

  <!--
    Koordinat proyek: groupId + artifactId + version = alamat unik proyek ini.
    groupId memakai domain kampus yang dibalik (univpancasila.ac.id menjadi
    id.ac.univpancasila) ditambah nama proyek.
  -->
  <groupId>id.ac.univpancasila.perpustakaan</groupId>
  <artifactId>perpustakaan</artifactId>
  <version>1.0.0</version>
  <packaging>jar</packaging>

  <name>Sistem Perpustakaan</name>
  <description>Praktikum PBO sesi 9 sampai 11 — Informatika UP</description>

  <properties>
    <!-- Java 25 LTS -->
    <maven.compiler.release>25</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
  </properties>

  <dependencies>
    <!--
      Dependensi eksternal yang benar-benar dipakai: Apache Commons Lang.
      App.java memakai StringUtils.rightPad, leftPad, dan repeat untuk
      merapikan tabel koleksi di terminal.
    -->
    <dependency>
      <groupId>org.apache.commons</groupId>
      <artifactId>commons-lang3</artifactId>
      <version>3.17.0</version>
    </dependency>

    <!--
      JUnit 5 untuk unit test (sesi 11). scope=test: hanya tersedia saat
      pengujian dan TIDAK ikut masuk ke berkas .jar hasil produksi.
    -->
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>5.11.3</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.13.0</version>
      </plugin>
      <!--
        Plugin exec agar bisa menjalankan program dengan:
            mvn exec:java -Dexec.mainClass=id.ac.univpancasila.perpustakaan.App
        (mainClass default juga sudah diisi di bawah)
      -->
      <!-- Surefire menjalankan kelas *Test di src/test/java saat: mvn test -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.5.2</version>
      </plugin>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <version>3.5.0</version>
        <configuration>
          <mainClass>id.ac.univpancasila.perpustakaan.App</mainClass>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
