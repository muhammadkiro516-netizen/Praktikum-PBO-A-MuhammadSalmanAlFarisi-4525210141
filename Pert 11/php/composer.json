{
    "name": "univpancasila/perpustakaan",
    "description": "Praktikum PBO sesi 9 sampai 11 — Informatika UP",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "nesbot/carbon": "^3.0"
    },
    "require-dev": {
