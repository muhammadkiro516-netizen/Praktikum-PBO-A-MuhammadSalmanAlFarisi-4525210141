@startuml
title Sequence Diagram: "  " + b untuk b = new Lingkaran(7) (dynamic dispatch)

participant Main
participant "Penggabungan String" as Gabung
participant "b : Lingkaran\n(inherit toString dari BangunDatar)" as Obj

Main -> Gabung : "  " + b
Gabung -> Obj : toString()
note right of Obj : Lingkaran tidak meng-override,\nyang berjalan BangunDatar.toString()\ndengan this = objek Lingkaran

Obj -> Obj : luas()
note right of Obj : invokevirtual: JVM mencari mulai dari\nkelas objek -> Lingkaran.luas()

Obj -> Obj : keliling()
note right of Obj : -> Lingkaran.keliling()

Obj --> Gabung : "Lingkaran    luas=    153,94  keliling=     43,98"
Gabung --> Main : String hasil
Main -> Main : System.out.println(String)
@enduml
